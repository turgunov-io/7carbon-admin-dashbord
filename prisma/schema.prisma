// 7Carbon — Prisma schema (docs 08_Database + 18_Prisma_Schema).
// PostgreSQL 17. UUID primary keys, createdAt/updatedAt everywhere,
// soft delete where recovery matters, indexed search columns.
// One schema serves both the Landing API and Dashboard API.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Enums ───────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ConsultationStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Locale {
  ru
  uz
  en
}

// ─────────────────────────── Auth ───────────────────────────

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String
  fullName     String
  avatar       String?
  role         UserRole  @default(MANAGER)
  language     Locale    @default(ru)
  isActive     Boolean   @default(true)
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions            Session[]
  auditLogs           AuditLog[]
  handledConsultations Consultation[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  refreshToken String   @unique
  expiresAt    DateTime
  ip           String?
  userAgent    String?
  revokedAt    DateTime?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@map("sessions")
}

// ─────────────────────── Catalog: Categories ───────────────────────

model Category {
  id          String        @id @default(uuid()) @db.Uuid
  parentId    String?       @db.Uuid
  slug        String        @unique
  title       String
  description String?
  image       String?
  sortOrder   Int           @default(0)
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([slug])
  @@index([parentId])
  @@index([status])
  @@map("categories")
}

// ─────────────────────── Catalog: Products ───────────────────────

model Product {
  id               String        @id @default(uuid()) @db.Uuid
  slug             String        @unique
  title            String
  // supplierBrand = the parts manufacturer (Akrapovic, Eventuri, ...).
  supplierBrand    String?
  // vehicleModel = free-text fitment string preserved from the source catalog.
  vehicleModel     String?
  shortDescription String?
  cardDescription  String?
  description       String?       @db.Text
  price            String? // display string preserved verbatim, e.g. "127,380.000 uzs"
  oldPrice         String?
  priceAmount      Int? // parsed numeric so'm for sorting/filtering
  cardImage        String?
  status           ProductStatus @default(ACTIVE)
  sortOrder        Int           @default(0)
  categoryId       String?       @db.Uuid
  seoId            String?       @unique @db.Uuid
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  category         Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  seo              Seo?                @relation(fields: [seoId], references: [id], onDelete: SetNull)
  images           ProductImage[]
  compatibleBrands ProductBrand[]
  compatibleModels ProductModel[]
  consultations    Consultation[]

  @@index([slug])
  @@index([status])
  @@index([categoryId])
  @@index([supplierBrand])
  @@index([createdAt])
  @@index([priceAmount])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  image     String
  alt       String?
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

// ─────────────────────── Vehicles ───────────────────────

model Brand {
  id        String        @id @default(uuid()) @db.Uuid
  name      String
  slug      String        @unique
  logo      String?
  country   String?
  status    ProductStatus @default(ACTIVE)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  models        Model[]
  products      ProductBrand[]
  consultations Consultation[]

  @@index([slug])
  @@index([status])
  @@map("brands")
}

model Model {
  id         String        @id @default(uuid()) @db.Uuid
  brandId    String        @db.Uuid
  name       String
  generation String?
  yearFrom   Int?
  yearTo     Int?
  status     ProductStatus @default(ACTIVE)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  brand         Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  products      ProductModel[]
  consultations Consultation[]

  @@index([brandId])
  @@index([status])
  @@map("models")
}

// Join tables for product ↔ vehicle compatibility.
model ProductBrand {
  productId String  @db.Uuid
  brandId   String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  brand     Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@id([productId, brandId])
  @@map("product_brands")
}

model ProductModel {
  productId String  @db.Uuid
  modelId   String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  model     Model   @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@id([productId, modelId])
  @@map("product_models")
}

// ─────────────────────── Services ───────────────────────

model Service {
  id          String        @id @default(uuid()) @db.Uuid
  slug        String        @unique
  serviceType String
  title       String
  summary     String?
  description  String?       @db.Text
  price       String?
  duration    String?
  gallery     String[]      @default([])
  status      ProductStatus @default(ACTIVE)
  seoId       String?       @unique @db.Uuid
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  seo           Seo?           @relation(fields: [seoId], references: [id], onDelete: SetNull)
  faqs          Faq[]
  consultations Consultation[]

  @@index([slug])
  @@index([status])
  @@map("services")
}

// ─────────────────────── Content ───────────────────────

model Gallery {
  id        String   @id @default(uuid()) @db.Uuid
  title     String?
  image     String
  category  String?
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([published])
  @@map("gallery")
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  customer  String
  vehicle   String?
  rating    Int      @default(5)
  text      String   @db.Text
  image     String?
  published Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([published])
  @@map("reviews")
}

model Faq {
  id        String   @id @default(uuid()) @db.Uuid
  serviceId String?  @db.Uuid
  question  String
  answer    String   @db.Text
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())

  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([published])
  @@map("faq")
}

model Partner {
  id        String   @id @default(uuid()) @db.Uuid
  name      String?
  logo      String
  url       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@map("partners")
}

// ─────────────────────── Consultations (CRM) ───────────────────────

model Consultation {
  id            String             @id @default(uuid()) @db.Uuid
  fullName      String
  phone         String
  telegram      String?
  email         String?
  brandId       String?            @db.Uuid
  modelId       String?            @db.Uuid
  carBrand      String? // free-text fallback when brand not in DB
  carModel      String?
  year          Int?
  productId     String?            @db.Uuid
  serviceId     String?            @db.Uuid
  preferredDate DateTime?
  message       String?            @db.Text
  attachments   String[]           @default([])
  status        ConsultationStatus @default(NEW)
  managerId     String?            @db.Uuid
  managerNotes  String?            @db.Text
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  brand   Brand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  model   Model?   @relation(fields: [modelId], references: [id], onDelete: SetNull)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  manager User?    @relation(fields: [managerId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([phone])
  @@index([createdAt])
  @@map("consultation_requests")
}

// ─────────────────────── Media library ───────────────────────

model Media {
  id           String   @id @default(uuid()) @db.Uuid
  fileName     String
  originalName String
  mime         String
  size         Int
  width        Int?
  height       Int?
  path         String
  folder       String   @default("root")
  alt          String?
  createdAt    DateTime @default(now())

  @@index([folder])
  @@map("media")
}

// ─────────────────────── SEO / i18n / config ───────────────────────

model Seo {
  id                 String   @id @default(uuid()) @db.Uuid
  title              String?
  description        String?
  keywords           String?
  canonical          String?
  ogTitle            String?
  ogDescription      String?
  twitterTitle       String?
  twitterDescription String?
  schemaJson         String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  product Product?
  service Service?

  @@map("seo")
}

// Generic translation table — (entity, entityId, locale, field) → value.
model Translation {
  id       String @id @default(uuid()) @db.Uuid
  entity   String
  entityId String @db.Uuid
  locale   Locale
  field    String
  value    String @db.Text

  @@unique([entity, entityId, locale, field])
  @@index([entity, entityId])
  @@map("translations")
}

model Homepage {
  id            String   @id @default(uuid()) @db.Uuid
  heroTitle     Json     @default("{}")
  heroSubtitle  Json     @default("{}")
  heroVideo     String?
  heroImage     String?
  aboutTitle    Json     @default("{}")
  aboutText     Json     @default("{}")
  metrics       Json     @default("[]")
  updatedAt     DateTime @updatedAt

  @@map("homepage")
}

model Settings {
  id              String   @id @default(uuid()) @db.Uuid
  companyName     String
  phone           String
  email           String
  telegram        String?
  instagram       String?
  youtube         String?
  address         Json     @default("[]")
  workingHours    Json     @default("[]")
  defaultLanguage Locale   @default(ru)
  theme           String   @default("dark")
  logo            String?
  favicon         String?
  analytics       String?
  updatedAt       DateTime @updatedAt

  @@map("settings")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  action    String
  entity    String
  entityId  String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@map("audit_logs")
}
