# ── Database ──
DATABASE_URL="postgresql://7carbon:7carbon@localhost:5432/7carbon?schema=public"

# ── Auth (generate strong random values in production) ──
# openssl rand -base64 48
JWT_ACCESS_SECRET="replace-with-64-char-random-secret-access"
JWT_REFRESH_SECRET="replace-with-64-char-random-secret-refresh"

# ── CORS — comma-separated origins allowed to call the API (the landing app) ──
CORS_ORIGINS="http://localhost:3000"

# ── Storage ──
STORAGE_DIR="./public/uploads"

# ── Seed admin credentials (first run only) ──
SEED_ADMIN_EMAIL="admin@7carbon.uz"
SEED_ADMIN_PASSWORD="ChangeMe_7Carbon!"
